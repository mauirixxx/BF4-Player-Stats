# Store production copy in /root/.config/bf4ps/admin-production.env (0600).
# Do not put real values in Git or in Apache public configuration.
BF4PS_ADMIN_USER=mauirixxx
BF4PS_ADMIN_ORIGIN=https://www.bf4playerstats.com
BF4PS_ADMIN_PASSWORD_FILE=/root/.config/bf4ps/admin-password.hash
BF4PS_ADMIN_SESSION_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS
BF4PS_DATABASE_URL=postgresql+psycopg://ADMIN_ROLE:SECRET@DB_HOST:5432/bf4_playerstats

# Artwork storage paths: private history must NOT be inside the web document root.
BF4PS_ARTWORK_CATALOG=/opt/bf4ps-website/site/equipment-artwork.js
BF4PS_ARTWORK_PRIVATE=/var/lib/bf4ps-admin/artwork
BF4PS_ARTWORK_PUBLIC=/var/www/bf4playerstats.com/assets/equipment-overrides
