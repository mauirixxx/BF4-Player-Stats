[Unit]
Description=BF4PS on-demand BA/BF4DB cache verifier
After=postgresql.service network-online.target
Wants=network-online.target
[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/bf4ps-general-rank-0026/website/scripts
ExecStart=/opt/bf4ps-general-rank-0026/.venv/bin/python -u ban_on_demand.py
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
[Install]
WantedBy=multi-user.target
