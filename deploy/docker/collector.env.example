# Copy to collector.env (never commit credentials).
BF4PS_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DB_HOST:5432/bf4_playerstats
# Generate a unique UUID once per node and retain it across container rebuilds.
BF4PS_COLLECTOR_UUID=REPLACE_WITH_NEW_STABLE_UUID
BF4PS_COLLECTOR_NAME=replace-with-unique-worker-name
BF4PS_EGRESS_KEY=replace-with-request-gate-egress-domain
