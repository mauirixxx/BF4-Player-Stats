[Unit]
Description=BF4PS read-only fleet telemetry (tcou-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/libexec/bf4ps-fleet-telemetry.py
EnvironmentFile=/etc/default/bf4ps-fleet-telemetry
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
