[Unit]
Description=BF4PS single-worker WAL-gated compact format-2 ranking publisher
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
Restart=always
RestartSec=20
TimeoutStopSec=60
ExecStartPre=-/usr/bin/docker rm -f bf4ps-compact-ranking
ExecStart=/usr/bin/docker run --rm --name bf4ps-compact-ranking --network host --env-file /opt/bf4ps-production/deploy/docker/collector.env -e BF4PS_SITE=mak -v /opt/bf4ps-compact-release/player-collector:/rank:ro -w /rank --entrypoint python bf4-player-stats:collector-ranking-versions-0016-candidate /rank/run_compact_rank_scheduler.py --max-publications 1000000000 --poll-seconds 30 --production-ack
ExecStop=/usr/bin/docker stop -t 45 bf4ps-compact-ranking

[Install]
WantedBy=multi-user.target
